                  <pdfaSchema:prefix>crossmark</pdfaSchema:prefix>
                  <pdfaSchema:schema>crossmark</pdfaSchema:schema>
                  <pdfaSchema:property>
                     <rdf:Seq>
                        <rdf:li rdf:parseType="Resource">
